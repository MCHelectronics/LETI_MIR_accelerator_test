# Tone exactly on FFT bin 400 (N=4096, Fs=1 MHz), amplitude 0.5:
# spectrum_view must report +97656.2 Hz at 20*log10(0.5) = -6.02 dBFS.
file(REMOVE "${OUT}.cf32" "${OUT}.cf32.json")
execute_process(COMMAND "${TONE}" "${OUT}.cf32" 1000000 97656.25 0.05 0.5 RESULT_VARIABLE r OUTPUT_QUIET)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "iq_tone failed")
endif()
execute_process(COMMAND "${VIEW}" "${OUT}.cf32" --nfft 4096 --peaks 1 RESULT_VARIABLE r OUTPUT_VARIABLE out)
message(STATUS "${out}")
if(NOT r EQUAL 0 OR NOT out MATCHES "\\+ *97656\\.2 Hz +(-[0-9.]+) dBFS")
  message(FATAL_ERROR "Tone line not found")
endif()
if(CMAKE_MATCH_1 LESS -6.3 OR CMAKE_MATCH_1 GREATER -5.7)
  message(FATAL_ERROR "Level ${CMAKE_MATCH_1} dBFS, expected -6.02")
endif()
foreach(view time spectrum waterfall)
  if(NOT EXISTS "${OUT}_${view}.png")
    message(FATAL_ERROR "Missing ${OUT}_${view}.png")
  endif()
endforeach()
